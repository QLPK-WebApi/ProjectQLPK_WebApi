@using BlazorServer.Models
@using BlazorServer.Services

<MudDialog @ref="_dialogRef" Visible="true" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h4" Class="text-center">Tạo lịch hẹn</MudText>
    </TitleContent>

    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }

            <MudStack Spacing="3">
                <div>
                    <MudNumericField T="int" @bind-Value="_model.PatientId" Label="Mã bệnh nhân(PatientId)"
                                    Variant="Variant.Outlined" Min="0" />
                    <ValidationMessage For="() => _model.PatientId" />
                </div>

                <div>
                    <MudNumericField T="int" @bind-Value="_model.DoctorId" Label="Mã bác sĩ(DoctorId)"
                                    Variant="Variant.Outlined" Min="0" />
                    <ValidationMessage For="() => _model.DoctorId" />
                </div>

                <MudTextField T="DateTime" @bind-Value="_model.AppointmentTime" Label="Thời gian hẹn"
                            InputType="InputType.DateTimeLocal" Format="s" Variant="Variant.Outlined" />

                <MudTextField @bind-Value="_model.Notes" Label="Ghi chú" Variant="Variant.Outlined" Lines="2" />
            </MudStack>

            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-2">
                <MudButton Variant="Variant.Outlined" OnClick="CancelAsync">Đóng</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit"
                           Disabled="@_saving">
                    @(_saving ? "Đang lưu..." : "Lưu")
                </MudButton>
            </MudStack>
        </EditForm>
    </DialogContent>
</MudDialog>


