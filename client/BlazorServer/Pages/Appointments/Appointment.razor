@using BlazorServer.Models
@using BlazorServer.Services

@page "/appointments"

@attribute [Authorize]


<PageTitle>Lịch hẹn - QLPK</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h3">Quản lý lịch hẹn</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">
        Tạo lịch hẹn
    </MudButton>
</MudStack>


<MudStack Row="true" Spacing="2" Class="mb-3" Style="max-width:400px;">
    <MudTextField @bind-Value="_keyword" Immediate="true" OnKeyUp="OnSearchKey"
                  Placeholder="Tìm theo bệnh nhân / bác sĩ / lý do..." Variant="Variant.Outlined" />

    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => LoadAsync(1)">Tìm</MudButton>
</MudStack>


@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
}

@if (_loading)
{
    <MudText>Đang tải...</MudText>
}

else if (_result is null || _result.Items.Count == 0)
{
    <MudAlert Severity="Severity.Info">Không có lịch hẹn nào</MudAlert>
}

else
{
    <MudTable Items="_result.Items" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>#</MudTh>
            <MudTh>Thời gian</MudTh>
            <MudTh>Bệnh nhân</MudTh>
            <MudTh>Bác sĩ</MudTh>
            <MudTh>Lý do</MudTh>
            <MudTh>Trạng thái</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="#">@context.Id</MudTd>
            <MudTd DataLabel="Thời gian">@context.AppointmentTime.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Bệnh nhân">@context.PatientName</MudTd>
            <MudTd DataLabel="Bác sĩ">@context.DoctorName</MudTd>
            <MudTd DataLabel="Lý do">@context.Reason</MudTd>
            <MudTd DataLabel="Trạng thái">
                <MudChip T="string" Color="@StatusColor(context.Status)" Size="Size.Small">@StatusText(context.Status)</MudChip>
            </MudTd>
            <MudTd Class="text-end">
                @if (context.Status == "Scheduled")
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" Class="me-1"
                               OnClick="() => ChangeStatus(context, CheckedIn)">Check-in</MudButton>
                }

                @if (context.Status is "Scheduled" or "CheckedIn")
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="me-1"
                               OnClick="() => ChangeStatus(context, Completed)">Hoàn tất</MudButton>

                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               OnClick="() => CancelAsync(context)">Hủy</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}


@if (_showCreate)
{
    <AppointmentCreateDialog OnSaved="OnCreated" OnCancel="() => _showCreate = false" />
}
