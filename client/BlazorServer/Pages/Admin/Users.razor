@page "/admin/users"

@implements IDisposable

<PageTitle>Người dùng & phân quyền - QLPK</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-1">
    <h1 class="h3 mb-0 fw-bold"><span class="badge bg-primary me-2">1</span>Tài khoản &amp; phân quyền</h1>
    <button type="button" class="btn btn-dark">+ Thêm</button>
</div>
<p class="text-muted small mb-4">Đăng nhập / Quản lý người dùng / Quản lý vai trò / Phân quyền truy cập</p>

<div class="input-group mb-3" style="max-width: 400px;">
    <input type="text" class="form-control" placeholder="Tìm theo tên đăng nhập / họ tên..."/>
    <button type="button" class="btn btn-outline-secondary">Tìm</button>
</div>

<div class="card mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>STT</th>
                    <th>Tên đăng nhập</th>
                    <th>Họ tên</th>
                    <th>Số điện thoại</th>
                    <th style="width: 200px;">Vai trò</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>

            <tbody class="">
                <tr>
                    <td>1</td>
                    <td>admin</td>
                    <td>Quản trị viên</td>
                    <td>0909 855 368</td>
                    <td>
                        <select class="form-select form-select-sm">
                            <option selected>Admin</option>
                            <option>Bác sĩ</option>
                            <option>Lễ Tân</option>
                        </select>
                    </td>
                    <td><span class="badge bg-success">Đang hoạt động</span></td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-primary">Sửa</button>
                    </td>
                </tr>

                <tr>
                    <td>2</td>
                    <td>bs.Hoàng</td>
                    <td>Nguyễn Văn Hoàng</td>
                    <td>0992 755 488</td>
                    <td>
                        <select class="form-select form-select-sm">
                            <option>Admin</option>
                            <option selected>Bác sĩ</option>
                            <option>Lễ tân</option>
                        </select>
                    </td>
                    <td><span class="badge bg-success">Đang hoạt động</span></td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-primary">Sửa</button>
                    </td>
                </tr>

                <tr>
                    <td>3</td>
                    <td>letan01</td>
                    <td>Trần Thị Tuyết Minh</td>
                    <td>0978 477 855</td>
                    <td>
                        <select class="form-select form-select-sm">
                            <option>Admin</option>
                            <option>Bác sĩ</option>
                            <option selected>Lễ Tân</option>
                        </select>
                    </td>
                    <td><span class="badge bg-secondary">Tạm khóa</span></td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-primary">Sửa</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>



<div class="card">
    <div class="card-header bg-white fw-semibold">Phân quyền truy cập - Nguyễn Văn Hoàng</div>
    <div class="card-body">
        <div class="row g-3 ">
            <div class="col-md-4 ">
                <div>
                    <input class="form-check-input" type="checkbox" id="perm-appointments" checked/>
                    <label class="form-check-label" for="perm-appointments">Quản lý lịch hẹn</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-check">
                    <input class="fomr-check-input" type="checkbox" id="perm-records" checked />
                    <label class="form-check-label" for="perm-records">Khám &amp; bệnh án</label>
                </div>
            </div>

            <div class="col-md-4 ">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="perm-prescriptions" checked/>
                    <label class="form-check-label" for="perm-prescriptions">Kê đơn thuốc</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="perm-orders"/>
                    <label class="form-check-label" for="perm-orders">Chỉ định &amp; kết quả</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="perm-catalog"/>
                    <label class="form-check-label" for="perm-catalog">Quản lý danh mục</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="perm-invoices"/>
                    <label class="form-check-label" for="perm-invoices">Hóa đơn &amp; thanh toán</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="perm-reports"/>
                    <label class="form-check-label" for="perm-reports">Báo cáo &amp; thống kê</label>
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer bg-white text-end">
        <button type="button" class="btn btn-dark">Lưu</button>
    </div>
    
</div>

@code{
    protected override void OnInitialized()
    {
        
    }

    public void Dispose()
    {

    }
}

