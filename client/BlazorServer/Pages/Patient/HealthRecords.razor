@page "/patient/health-records"
@implements IDisposable

<PageTitle>Tra cứu y tế - QLPK</PageTitle>
<MudStack Row="true" AlignItems="AlignItems.Center">
    <MudChip T="string" Size="Size.Medium" Color="Color.Error">
        3
    </MudChip>

    <MudText Typo="Typo.h4" Style="font-weight: 700">
        Tra cứu y tế
    </MudText>
</MudStack>


<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Xem bệnh án · Xem đơn thuốc · Xem kết quả XN </MudText>

    <MudPaper>

        <!-- Header -->
        <MudPaper Elevation="0" Square="true" Class="pa-3" Style="background-color:#f8f3f3;">

            <MudText Typo="Typo.subtitle1">
                App · Hồ sơ sức khỏe của tôi
            </MudText>

        </MudPaper>


        <!-- Body -->
        <MudCardContent Class="wf-phone-body">

            <!-- ============================= -->
            <!-- Tabs -->
            <!-- ============================= -->

            <MudTabs Rounded="true" Elevation="0" Class="mb-4">

                <MudTabPanel Text="Bệnh án">

                    <!-- Nội dung bệnh án -->

                </MudTabPanel>

                <MudTabPanel Text="Đơn thuốc">

                    <!-- Nội dung đơn thuốc -->

                </MudTabPanel>

                <MudTabPanel Text="Kết quả">

                    <!-- Nội dung kết quả xét nghiệm -->

                </MudTabPanel>

            </MudTabs>


            <!-- ============================= -->
            <!-- Chọn lượt khám -->
            <!-- ============================= -->

            <MudText Typo="Typo.body2" Class="fw-semibold mb-2">

                Chọn lượt khám

            </MudText>


            <MudList T="string" Dense="true" DisableGutters="true" Class="mb-3">

                <!-- Lượt khám 12/05 -->
                <MudListItem>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">

                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">

                            12/05

                        </MudChip>

                        <MudText Typo="Typo.body2">
                            Viêm họng cấp · BS. Nguyễn Văn Hoàng
                        </MudText>

                    </MudStack>

                </MudListItem>


                <!-- Lượt khám 28/04 -->
                <MudListItem>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">

                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">

                            28/04

                        </MudChip>

                        <MudText Typo="Typo.body2">
                            Viêm dạ dày · BS. Trần Thu Hà
                        </MudText>

                    </MudStack>

                </MudListItem>

            </MudList>


            <!-- ============================= -->
            <!-- Chi tiết lượt khám -->
            <!-- ============================= -->

            <MudPaper Outlined="true" Class="pa-3 mb-3">

                <MudText Typo="Typo.subtitle2" Class="mb-3">

                    Chi tiết lượt khám 12/05/2026

                </MudText>


                <MudGrid Spacing="1">

                    <!-- Lý do khám -->
                    <MudItem xs="5">

                        <MudText Typo="Typo.body2" Color="Color.Secondary">

                            Lý do khám

                        </MudText>

                    </MudItem>

                    <MudItem xs="7">

                        <MudText Typo="Typo.body2">
                            Đau họng, sốt nhẹ
                        </MudText>

                    </MudItem>


                    <!-- Chẩn đoán -->
                    <MudItem xs="5">

                        <MudText Typo="Typo.body2" Color="Color.Secondary">

                            Chẩn đoán

                        </MudText>

                    </MudItem>

                    <MudItem xs="7">

                        <MudText Typo="Typo.body2">
                            Viêm họng cấp
                        </MudText>

                    </MudItem>


                    <!-- Kết luận -->
                    <MudItem xs="5">

                        <MudText Typo="Typo.body2" Color="Color.Secondary">

                            Kết luận

                        </MudText>

                    </MudItem>

                    <MudItem xs="7">

                        <MudText Typo="Typo.body2">
                            Điều trị ngoại trú, tái khám sau 7 ngày
                        </MudText>

                    </MudItem>


                    <!-- Đơn thuốc -->
                    <MudItem xs="5">

                        <MudText Typo="Typo.body2" Color="Color.Secondary">

                            Đơn thuốc

                        </MudText>

                    </MudItem>

                    <MudItem xs="7">

                        <MudText Typo="Typo.body2">
                            Paracetamol 500mg · Alpha Choay
                        </MudText>

                    </MudItem>


                    <!-- Kết quả XN -->
                    <MudItem xs="5">

                        <MudText Typo="Typo.body2" Color="Color.Secondary">

                            Kết quả XN

                        </MudText>

                    </MudItem>

                    <MudItem xs="7">

                        <MudText Typo="Typo.body2">
                            Công thức máu — trong giới hạn bình thường
                        </MudText>

                    </MudItem>

                </MudGrid>

            </MudPaper>


            <!-- ============================= -->
            <!-- Download / Share -->
            <!-- ============================= -->

            <MudStack Row="true" Justify="Justify.FlexEnd">

                <MudButton Variant="Variant.Outlined" Color="Color.Dark">

                    Tải về / Chia sẻ

                </MudButton>

            </MudStack>

        </MudCardContent>

    </MudPaper>

@code {
protected override void OnInitialized()
    {
        // Khởi tạo dữ liệu màn hình (chưa hiện thực).
    }

    public void Dispose()
    {
        // Giải phóng tài nguyên của màn hình (chưa hiện thực).
    }

}




















